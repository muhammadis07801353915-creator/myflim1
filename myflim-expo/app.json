{
  "expo": {
    "name": "Taban Play",
    "slug": "myflim-mobile",
    "scheme": "myflim",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/app-logo-new.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-screen-full.png",
      "resizeMode": "cover",
      "backgroundColor": "#0F0F13"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.muhamad.myflim",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [],
    "owner": "taboo1",
    "extra": {
      "eas": {
        "projectId": "1cd8d1cd-bc48-4bf2-9be8-229f10299656"
      }
    }
  }
}
